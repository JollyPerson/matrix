{
    "version": 6,
    "configurePresets": [
        {
            "name": "debug-macos",
            "displayName": "Debug (macOS)",
            "generator": "Unix Makefiles",
            "binaryDir": "${sourceDir}/build/Debug",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
            },
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_C_COMPILER": "/usr/local/bin/gcc-15",
                "CMAKE_CXX_COMPILER": "/usr/local/bin/g++-15"
            }
        },
        {
            "name": "release-macos",
            "displayName": "Release (macOS)",
            "generator": "Unix Makefiles",
            "binaryDir": "${sourceDir}/build/Release",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
            },
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_C_COMPILER": "/usr/local/bin/gcc-15",
                "CMAKE_CXX_COMPILER": "/usr/local/bin/g++-15"
            }
        },
        {
            "name": "sanitize-macos",
            "displayName": "Sanitizers (macOS Clang)",
            "generator": "Unix Makefiles",
            "binaryDir": "${sourceDir}/build/Sanitize",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
            },
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_CXX_COMPILER": "/usr/bin/clang++",
                "MATRIX_ENABLE_SANITIZERS": "ON"
            }
        },
        {
            "name": "debug-windows",
            "displayName": "Debug (Windows/MSYS2)",
            "generator": "MinGW Makefiles",
            "binaryDir": "${sourceDir}/build/Debug",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            },
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_C_COMPILER": "C:/msys64/ucrt64/bin/gcc.exe",
                "CMAKE_CXX_COMPILER": "C:/msys64/ucrt64/bin/g++.exe"
            }
        },
        {
            "name": "release-windows",
            "displayName": "Release (Windows/MSYS2)",
            "generator": "MinGW Makefiles",
            "binaryDir": "${sourceDir}/build/Release",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            },
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_C_COMPILER": "C:/msys64/ucrt64/bin/gcc.exe",
                "CMAKE_CXX_COMPILER": "C:/msys64/ucrt64/bin/g++.exe"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "debug-macos",
            "configurePreset": "debug-macos"
        },
        {
            "name": "release-macos",
            "configurePreset": "release-macos"
        },
        {
            "name": "sanitize-macos",
            "configurePreset": "sanitize-macos"
        },
        {
            "name": "debug-windows",
            "configurePreset": "debug-windows"
        },
        {
            "name": "release-windows",
            "configurePreset": "release-windows"
        }
    ]
}

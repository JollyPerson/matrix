{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake: Configure Debug",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--preset",
                "debug-macos"
            ],
            "windows": {
                "args": [
                    "--preset",
                    "debug-windows"
                ]
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build"
        },
        {
            "label": "CMake: Build Debug",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "--preset",
                "debug-macos"
            ],
            "windows": {
                "args": [
                    "--build",
                    "--preset",
                    "debug-windows"
                ]
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            }
        },
        {
            "label": "CMake: Run Debug",
            "type": "shell",
            "command": "${workspaceFolder}/build/Debug/matrix_tests",
            "windows": {
                "command": "${workspaceFolder}\\build\\Debug\\matrix_tests.exe"
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "CMake: Build Debug",
            "problemMatcher": []
        },
        {
            "label": "CMake: Configure Release",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--preset",
                "release-macos"
            ],
            "windows": {
                "args": [
                    "--preset",
                    "release-windows"
                ]
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build"
        },
        {
            "label": "CMake: Build Release",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "--preset",
                "release-macos"
            ],
            "windows": {
                "args": [
                    "--build",
                    "--preset",
                    "release-windows"
                ]
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build"
        },
        {
            "label": "CMake: Run Release",
            "type": "shell",
            "command": "${workspaceFolder}/build/Release/matrix_tests",
            "windows": {
                "command": "${workspaceFolder}\\build\\Release\\matrix_tests.exe"
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "CMake: Build Release",
            "problemMatcher": []
        },
        {
            "type": "cppbuild",
            "label": "C/C++: clang++ build active file",
            "command": "/usr/bin/clang++",
            "windows": {
                "command": "C:\\msys64\\ucrt64\\bin\\g++.exe"
            },
            "args": [
                "-fcolor-diagnostics",
                "-fansi-escape-codes",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        }
    ]
}